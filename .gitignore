.claude/edit-log.jsonl
.mcp.json
.claude/.javaducker/
.claude/.grok-fleet/
*.png
*.jpg
*.jpeg
*.gif
# Every shell asset is stored as text (*.sh.txt) and materialised by init. The generated *.sh
# files are therefore build output and never belong in git.
*.sh
*.bat
.claude/df/repo-intel/run
# ...except the bash test corpus, which is data: the extractor is being tested precisely on its
# ability to recognise .sh files, so these must exist with that extension.
!tests/repo-intel/fixtures/**/*.sh
setup-backup/
reports/grok-*.json
reports/grok-*.md
# per-run fleet reports are transient; the gate summaries (codex-fleet.json, codex-doctor.json)
# stay tracked because they are the evidence behind the numbers in the docs
reports/codex-fleet-*.json
reports/codex-fleet-*.md
.ri-test/
.claude/docs/
.ri-build/
.ri-build-t/
__pycache__/
*.pyc
.claude/df/
.claude/.fleet/
